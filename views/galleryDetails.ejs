<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gallery – <%= gallery.location %> – WanderWay</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="gallery-details-bg">

  <%- include("partials/navbar") %>

  <!-- Page Header -->
  <div class="page-header">
    <span class="section-label" style="color:var(--orange-light)">Gallery</span>
    <h2 class="details-title">
      <i class="fa-solid fa-location-dot"></i>
      <%= gallery.location %>
    </h2>
    <p class="uploaded-info">Uploaded by <strong><%= gallery.uploadedBy %></strong></p>
  </div>

  <div class="container">

    <!-- Images Grid -->
    <div class="details-gallery">
      <% gallery.images.forEach(img => { %>
        <div class="details-image">
          <img src="<%= img %>" alt="Gallery Image">
        </div>
      <% }) %>
    </div>

    <!-- Back button -->
    <div class="back-btn-wrapper" style="margin-top:40px">
      <a href="/gallery" class="back-btn">Back to Gallery</a>
    </div>

  </div>

  <footer class="footer">
    <strong>WanderWay</strong>
    <p>© 2025 WanderWay. All Rights Reserved.</p>
  </footer>

</body>
</html>
