  <script>
  // Fast Intersection Observer — fires as soon as 8% is visible
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add("zp-visible");
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.08, rootMargin: "0px 0px -40px 0px" });

  document.querySelectorAll(".zp-fade-section, .zp-card-reveal").forEach(el => io.observe(el));
  </script>

