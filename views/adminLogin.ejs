<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login – Zappit</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="admin-bg">

  <!-- Centre the card in the remaining viewport height, navbar stays at top -->
  <div style="flex:1;display:flex;align-items:center;justify-content:center;padding:32px 20px;position:relative;z-index:2">
    <div class="admin-login-container">

      <h2>👑 Admin Login</h2>

      <% if (error) { %>
        <p class="error" style="text-align:center"><%= error %></p>
      <% } %>

      <form action="/admin/login" method="POST">
        <input type="email" name="email" placeholder="Admin Email" required>
        <input type="password" name="password" placeholder="Password" required>
        <button type="submit">Login →</button>
      </form>

      <a href="/" class="back-link">← Back to Home</a>

    </div>
  </div>

</body>
</html>
