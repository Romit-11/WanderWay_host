<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login – WanderWay</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="user-login-bg">

  <%- include("partials/navbar") %>

  <div style="flex:1;display:flex;align-items:center;justify-content:center;padding:32px 20px">
    <div class="auth-container login-animate">

      <h2>✨ Welcome Back</h2>
      <p style="font-size:14px;color:var(--text-muted);margin-bottom:28px">Sign in to continue your journey ✈️</p>

      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>

      <form method="POST" action="/login">
        <div>
          <label>Email Address</label>
          <input type="email" name="email" placeholder="you@example.com" required>
        </div>
        <div>
          <label>Password</label>
          <input type="password" name="password" placeholder="••••••••" required>
        </div>
        <button type="submit">Login →</button>
      </form>

      <p style="margin-top:16px">Don't have an account? <a href="/register">Register here</a></p>

      <hr style="border:none;border-top:1px solid var(--border-soft);margin:18px 0">

      <p style="font-size:13px;text-align:center;color:var(--text-muted)">
        Are you an admin? <a href="/admin/login" style="color:var(--text-muted);font-weight:600">Login as Admin</a>
      </p>
      <p style="font-size:13px;text-align:center;margin-top:8px;color:var(--text-muted)">
        Are you a hotel owner? <a href="/hotel-owner/login" style="color:var(--text-muted);font-weight:600">Login as Hotel Owner</a>
      </p>

    </div>
  </div>

</body>
</html>
