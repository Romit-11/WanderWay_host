<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Blog – Zappit</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="blog-bg">

  <%- include("partials/navbar") %>

  <!-- Page Header -->
  <div class="page-header">
    <span class="section-label" style="color:var(--orange-light)">Travel Stories</span>
    <h2>Travel Blog</h2>
    <p>Share your travel stories with the Zappit community</p>
  </div>

  <div class="blog-list">

    <!-- Add Blog Form -->
    <% if (user) { %>
      <div class="form-container" style="margin-bottom:40px">
        <h3>✍️ Share Your Story</h3>
        <form action="/blog" method="POST">
          <input type="text" name="title" placeholder="Blog Title" required>
          <textarea name="content" placeholder="Write your travel story..." required></textarea>
          <button type="submit">📝 Post Story</button>
        </form>
      </div>
    <% } %>

    <!-- Blog List -->
    <% if (blogs && blogs.length > 0) { %>
      <% blogs.forEach(blog => { %>
        <div class="blog-item">
          <h3><%= blog.title %></h3>
          <p><%= blog.content %></p>
          <small>✍️ By <%= blog.author %> &nbsp;·&nbsp; <%= blog.createdAt.toDateString() %></small>

          <% if (user && user._id.toString() === blog.authorId.toString()) { %>
            <div style="margin-top:12px;display:flex;gap:10px;flex-wrap:wrap">
              <form action="/blog/edit/<%= blog._id %>" method="get" style="display:inline">
                <button type="submit" class="btn" style="padding:7px 16px;font-size:13px;background:var(--orange-pale);color:var(--orange-dark);border:1px solid var(--border);border-radius:var(--r-pill)">✏️ Edit</button>
              </form>
              <form action="/blog/delete/<%= blog._id %>" method="post" style="display:inline">
                <button type="submit" class="btn-danger" onclick="return confirm('Delete this blog?')">🗑 Delete</button>
              </form>
            </div>
          <% } %>
        </div>
      <% }) %>
    <% } else { %>
      <p class="empty-msg" style="color:rgba(255,255,255,.7);text-align:center;padding:40px 0">No blogs yet. Be the first to share your story!</p>
    <% } %>

  </div>

  <footer class="footer">
    <strong>Zappit</strong>
    <p>© 2025 Zappit. All Rights Reserved.</p>
  </footer>

</body>
</html>
