<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin – Gallery – WanderWay</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="admin-bg">

  <div class="admin-overlay"></div>

  <div class="admin-container">

    <div class="admin-header">
      <h1>🖼 Gallery Uploads</h1>
      <a href="/admin/dashboard" class="logout-btn" style="background:linear-gradient(135deg,var(--orange-dark),var(--orange))">← Dashboard</a>
    </div>

    <div class="admin-grid">
      <% galleries.forEach(g => { %>
        <div class="admin-card">
          <img src="<%= g.images[0] %>" alt="">
          <h3>📍 <%= g.location %></h3>
          <p>By <%= g.uploadedBy %></p>
          <form action="/admin/galleries/delete/<%= g._id %>" method="POST" style="margin-top:auto">
            <button class="danger-btn">🗑 Delete</button>
          </form>
        </div>
      <% }) %>
    </div>

  </div>

</body>
</html>
