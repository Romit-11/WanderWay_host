<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Trending Place – Zappit Admin</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="admin-bg">

  <div class="admin-overlay"></div>

  <div style="display:flex;align-items:center;justify-content:center;min-height:100vh;padding:40px 24px;position:relative;z-index:2">
    <div class="form-container" style="max-width:640px;width:100%;border-top-color:var(--orange)">
      <h3>🔥 Add Trending Place</h3>
      <form action="/admin/add-trending" method="POST" enctype="multipart/form-data">
        <input type="text" name="name" placeholder="Place Name" required>
        <textarea name="description" placeholder="Description" rows="4" required></textarea>
        <input type="text" name="location" placeholder="Location (e.g. Shimla, India)" required>
        <input type="text" name="nearbyHotel" placeholder="Nearby Hotel" required>
        <div>
          <label style="font-size:12px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.6px;display:block;margin-bottom:8px">Upload Images</label>
          <input type="file" name="images" multiple required style="font-family:var(--fb);font-size:14px">
        </div>
        <button type="submit">➕ Add Place</button>
      </form>
      <div style="text-align:center;margin-top:18px">
        <a href="/admin/dashboard" style="color:var(--orange);font-weight:600;font-size:14px">← Back to Dashboard</a>
      </div>
    </div>
  </div>

</body>
</html>
