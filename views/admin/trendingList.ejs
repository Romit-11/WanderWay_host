<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin – Trending Places – WanderWay</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="admin-bg">

  <div class="admin-overlay"></div>

  <div class="admin-container">

    <div class="admin-header">
      <h1>🔥 Trending Places</h1>
      <div style="display:flex;gap:12px;justify-content:center;margin-top:12px;flex-wrap:wrap">
        <a href="/admin/add-trending" class="primary-btn">➕ Add New Place</a>
        <a href="/admin/dashboard" class="logout-btn" style="background:linear-gradient(135deg,var(--orange-dark),var(--orange))">← Dashboard</a>
      </div>
    </div>

    <div class="admin-grid">
      <% places.forEach(p => { %>
        <div class="admin-card">
          <% if (p.images && p.images.length > 0) { %>
            <img src="<%- p.images[0] && p.images[0].startsWith('http') ? p.images[0] : '/uploads/' + p.images[0] %>" alt="<%= p.name %>">
          <% } else { %>
            <div style="width:100%;height:150px;background:rgba(255,255,255,.1);border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;margin-bottom:12px;color:rgba(255,255,255,.4);font-size:32px">🏔️</div>
          <% } %>
          <h3><%= p.name %></h3>
          <p>📍 <%= p.location %></p>
          <p style="font-size:12px;color:rgba(255,255,255,.45)">🏨 <%= p.nearbyHotel %></p>
          <form action="/admin/delete-trending/<%= p._id %>" method="POST" style="margin-top:auto">
            <button type="submit" class="danger-btn">🗑 Delete</button>
          </form>
        </div>
      <% }) %>
    </div>

  </div>

</body>
</html>
