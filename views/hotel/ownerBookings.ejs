<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>All Bookings – Zappit Owner</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    .bk-table-wrap{overflow-x:auto;margin-top:20px}
    table{width:100%;border-collapse:collapse;font-size:14px;min-width:700px}
    th{text-align:left;padding:12px 16px;color:var(--orange-light);font-size:11px;text-transform:uppercase;letter-spacing:1px;border-bottom:1px solid rgba(249,115,22,.3)}
    td{padding:12px 16px;color:rgba(255,255,255,.82);border-bottom:1px solid rgba(255,255,255,.06);vertical-align:top}
    tr:hover td{background:rgba(255,255,255,.04)}
    .badge{padding:4px 10px;border-radius:999px;font-size:11px;font-weight:700}
  </style>
</head>
<body class="admin-bg">
  <div class="admin-overlay"></div>
  <div class="admin-container">
    <div class="admin-header">
      <h1>📋 All Bookings</h1>
      <div style="display:flex;gap:10px;justify-content:center;margin-top:12px;flex-wrap:wrap">
        <a href="/hotel-owner/dashboard" class="logout-btn" style="background:linear-gradient(135deg,var(--orange-dark),var(--orange))">← Dashboard</a>
      </div>
    </div>

    <% if(bookings.length===0){ %>
      <p style="color:rgba(255,255,255,.6);text-align:center;padding:60px 0;font-size:16px">No bookings received yet.</p>
    <% } else { %>
      <div class="bk-table-wrap">
        <table>
          <thead>
            <tr>
              <th>Guest</th><th>Hotel</th><th>Room</th><th>Check-in</th><th>Check-out</th><th>Nights</th><th>Rooms</th><th>Amount</th><th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% bookings.forEach(b=>{ %>
              <tr>
                <td>
                  <strong style="color:#fff"><%= b.userName %></strong><br>
                  <span style="font-size:12px;color:rgba(255,255,255,.45)"><%= b.userEmail %></span><br>
                  <span style="font-size:12px;color:rgba(255,255,255,.45)"><%= b.userPhone %></span>
                </td>
                <td><%= b.hotelName %></td>
                <td><%= b.roomType %></td>
                <td style="font-size:13px"><%= new Date(b.checkIn).toDateString() %></td>
                <td style="font-size:13px"><%= new Date(b.checkOut).toDateString() %></td>
                <td><%= b.nights %></td>
                <td><%= b.rooms %></td>
                <td style="color:var(--orange-light);font-weight:700">₹<%= b.totalAmount.toLocaleString() %></td>
                <td>
                  <span class="badge" style="
                    background:<%= b.status==='confirmed'?'rgba(22,163,74,.3)':b.status==='cancelled'?'rgba(220,38,38,.3)':'rgba(249,115,22,.3)' %>;
                    color:<%= b.status==='confirmed'?'#86efac':b.status==='cancelled'?'#fca5a5':'#fdba74' %>">
                    <%= b.status.toUpperCase() %>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</body>
</html>
