<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Add Hotel – Zappit</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    .hotel-form { max-width:820px;margin:0 auto 80px;padding:0 20px }
    .form-section { background:rgba(255,255,255,.97);border-radius:var(--r-lg);padding:32px 36px;margin-bottom:24px;border-top:4px solid var(--orange);box-shadow:var(--shadow-md) }
    .form-section h3 { font-family:var(--fd);font-size:22px;color:var(--text-dark);margin-bottom:22px;padding-bottom:10px;border-bottom:2px solid var(--orange-pale) }
    .form-grid { display:grid;grid-template-columns:1fr 1fr;gap:16px }
    .form-grid.three { grid-template-columns:1fr 1fr 1fr }
    .form-group { display:flex;flex-direction:column;gap:6px }
    .form-group label { font-size:12px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.6px }
    .form-group input,.form-group select,.form-group textarea {
      padding:12px 14px;font-family:var(--fb);font-size:14px;
      border:1.5px solid var(--border-soft);border-radius:var(--r-sm);
      background:var(--cream);color:var(--text-dark);outline:none;transition:var(--tr)
    }
    .form-group textarea { min-height:100px;resize:vertical }
    .form-group input:focus,.form-group select:focus,.form-group textarea:focus {
      border-color:var(--orange);background:#fff;box-shadow:0 0 0 4px rgba(249,115,22,.08)
    }
    .full { grid-column:1/-1 }
    .amenity-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px;margin-top:8px }
    .amenity-label { display:flex;align-items:center;gap:8px;padding:10px 14px;border:1.5px solid var(--border-soft);border-radius:var(--r-sm);cursor:pointer;transition:var(--tr);font-size:13px;font-weight:500 }
    .amenity-label:has(input:checked) { border-color:var(--orange);background:var(--orange-pale);color:var(--orange-dark) }
    .amenity-label input { accent-color:var(--orange) }
    .room-entry { background:var(--cream);border-radius:var(--r-md);padding:20px;margin-bottom:16px;border:1.5px solid var(--border-soft);position:relative }
    .room-entry .remove-room { position:absolute;top:12px;right:12px;background:var(--red);color:#fff;border:none;border-radius:50%;width:26px;height:26px;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center }
    .add-room-btn { display:inline-flex;align-items:center;gap:8px;padding:10px 20px;background:var(--orange-pale);color:var(--orange-dark);border:1.5px dashed var(--orange);border-radius:var(--r-pill);font-family:var(--fb);font-size:14px;font-weight:600;cursor:pointer;transition:var(--tr) }
    .add-room-btn:hover { background:var(--orange);color:#fff }
    .submit-btn { width:100%;padding:16px;font-family:var(--fb);font-size:16px;font-weight:700;background:linear-gradient(135deg,var(--orange),var(--orange-light));color:#fff;border:none;border-radius:var(--r-pill);cursor:pointer;box-shadow:var(--shadow-md);transition:var(--tr) }
    .submit-btn:hover { transform:translateY(-3px);box-shadow:var(--shadow-lg) }
    @media(max-width:600px){ .form-grid,.form-grid.three { grid-template-columns:1fr } }
  </style>
</head>
<body class="admin-bg">
  <div class="admin-overlay"></div>

  <div style="position:relative;z-index:2;padding-top:20px">
    <div class="page-header" style="padding:40px 24px 28px">
      <span class="section-label" style="color:var(--orange-light)">Hotel Partner</span>
      <h2>➕ Add Your Hotel</h2>
      <p>Fill in all details to list your property on Zappit</p>
    </div>

    <% if(error){ %>
      <p class="error" style="text-align:center;font-size:15px;margin-bottom:16px"><%= error %></p>
    <% } %>

    <form action="/hotel-owner/add-hotel" method="POST" enctype="multipart/form-data" class="hotel-form">

      <!-- Basic Info -->
      <div class="form-section">
        <h3>📋 Basic Information</h3>
        <div class="form-grid">
          <div class="form-group full"><label>Hotel Name *</label><input type="text" name="name" placeholder="e.g. The Grand Shimla Resort" required></div>
          <div class="form-group"><label>Star Rating *</label>
            <select name="starRating" required>
              <option value="1">⭐ 1 Star</option>
              <option value="2">⭐⭐ 2 Star</option>
              <option value="3" selected>⭐⭐⭐ 3 Star</option>
              <option value="4">⭐⭐⭐⭐ 4 Star</option>
              <option value="5">⭐⭐⭐⭐⭐ 5 Star</option>
            </select>
          </div>
          <div class="form-group"><label>City *</label><input type="text" name="city" placeholder="e.g. Shimla" required></div>
          <div class="form-group full"><label>Full Address *</label><input type="text" name="address" placeholder="e.g. The Mall Road, Shimla, HP 171001" required></div>
          <div class="form-group full"><label>Location (for search) *</label><input type="text" name="location" placeholder="e.g. Shimla, Himachal Pradesh, India" required></div>
          <div class="form-group full"><label>Description *</label><textarea name="description" placeholder="Describe your hotel, surroundings, atmosphere..." required></textarea></div>
        </div>
      </div>

      <!-- Contact -->
      <div class="form-section">
        <h3>📞 Contact & Check-in</h3>
        <div class="form-grid">
          <div class="form-group"><label>Phone</label><input type="tel" name="phone" placeholder="+91 9876543210"></div>
          <div class="form-group"><label>Hotel Email</label><input type="email" name="email" placeholder="info@myhotel.com"></div>
          <div class="form-group"><label>Check-in Time</label><input type="time" name="checkInTime" value="14:00"></div>
          <div class="form-group"><label>Check-out Time</label><input type="time" name="checkOutTime" value="12:00"></div>
          <div class="form-group full"><label>Policies (cancellation, pets, etc.)</label><textarea name="policies" placeholder="Free cancellation up to 24 hours before check-in..."></textarea></div>
        </div>
      </div>

      <!-- Amenities -->
      <div class="form-section">
        <h3>✨ Hotel Amenities</h3>
        <div class="amenity-grid">
          <% ["Free WiFi","Swimming Pool","Gym / Fitness","Restaurant","Bar / Lounge","Spa & Wellness","Free Parking","Airport Shuttle","Room Service","Laundry","Business Centre","Conference Room","Kids Play Area","Pet Friendly","24-hr Front Desk","Elevator","Non-Smoking Rooms","Air Conditioning"].forEach(a=>{ %>
            <label class="amenity-label">
              <input type="checkbox" name="amenities" value="<%= a %>"> <%= a %>
            </label>
          <% }) %>
        </div>
      </div>

      <!-- Room Types -->
      <div class="form-section">
        <h3>🛏️ Room Types</h3>
        <p style="font-size:13px;color:var(--text-muted);margin-bottom:16px">Add at least one room type. Users will choose from these when booking.</p>
        <div id="roomsContainer">
          <div class="room-entry" data-index="0">
            <strong style="font-size:14px;color:var(--text-dark)">Room Type 1</strong>
            <button type="button" class="remove-room" onclick="removeRoom(this)" style="display:none">×</button>
            <div class="form-grid three" style="margin-top:14px">
              <div class="form-group"><label>Room Type Name *</label><input type="text" name="roomType" placeholder="e.g. Deluxe Room" required></div>
              <div class="form-group"><label>Price per Night (₹) *</label><input type="number" name="roomPrice" placeholder="2500" min="1" required></div>
              <div class="form-group"><label>Max Guests *</label><input type="number" name="roomGuests" placeholder="2" min="1" max="10" required></div>
              <div class="form-group"><label>Bed Configuration</label><input type="text" name="roomBeds" placeholder="1 King Bed"></div>
              <div class="form-group"><label>Room Size</label><input type="text" name="roomSize" placeholder="28 sqm"></div>
              <div class="form-group"><label>Rooms Available</label><input type="number" name="roomAvailable" placeholder="5" min="1" value="5"></div>
              <div class="form-group full"><label>Room Amenities (comma-separated)</label><input type="text" name="roomAmenities" placeholder="AC, TV, Mini Bar, Safe, Balcony"></div>
            </div>
          </div>
        </div>
        <button type="button" class="add-room-btn" onclick="addRoom()">➕ Add Another Room Type</button>
      </div>

      <!-- Photos -->
      <div class="form-section">
        <h3>📸 Hotel Photos</h3>
        <p style="font-size:13px;color:var(--text-muted);margin-bottom:14px">Upload high-quality photos (max 10). First image will be the cover.</p>
        <input type="file" name="images" accept="image/*" multiple required style="font-family:var(--fb);font-size:14px">
      </div>

      <button type="submit" class="submit-btn">🏨 Publish Hotel Listing</button>
    </form>
  </div>

  <script>
  let roomCount = 1;
  function addRoom(){
    roomCount++;
    const c = document.getElementById("roomsContainer");
    const d = document.createElement("div");
    d.className = "room-entry";
    d.setAttribute("data-index", roomCount-1);
    d.innerHTML = `
      <strong style="font-size:14px;color:var(--text-dark)">Room Type ${roomCount}</strong>
      <button type="button" class="remove-room" onclick="removeRoom(this)">×</button>
      <div class="form-grid three" style="margin-top:14px">
        <div class="form-group"><label>Room Type Name *</label><input type="text" name="roomType" placeholder="e.g. Suite" required></div>
        <div class="form-group"><label>Price per Night (₹) *</label><input type="number" name="roomPrice" placeholder="5000" min="1" required></div>
        <div class="form-group"><label>Max Guests *</label><input type="number" name="roomGuests" placeholder="2" min="1" max="10" required></div>
        <div class="form-group"><label>Bed Configuration</label><input type="text" name="roomBeds" placeholder="1 King Bed"></div>
        <div class="form-group"><label>Room Size</label><input type="text" name="roomSize" placeholder="45 sqm"></div>
        <div class="form-group"><label>Rooms Available</label><input type="number" name="roomAvailable" placeholder="3" min="1" value="3"></div>
        <div class="form-group full"><label>Room Amenities (comma-separated)</label><input type="text" name="roomAmenities" placeholder="AC, Jacuzzi, Mini Bar, Balcony"></div>
      </div>`;
    c.appendChild(d);
    updateRemoveButtons();
  }
  function removeRoom(btn){ btn.closest(".room-entry").remove(); roomCount--; updateRemoveButtons(); }
  function updateRemoveButtons(){
    const entries = document.querySelectorAll(".room-entry");
    entries.forEach((e,i)=>{ e.querySelector(".remove-room").style.display = entries.length>1?"flex":"none"; });
  }
  </script>
</body>
</html>
