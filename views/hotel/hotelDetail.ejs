<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= hotel.name %> – Zappit</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    /* ── HERO ── */
    .hd-hero { position:relative; height:420px; overflow:hidden; }
    .hd-hero-img { width:100%; height:420px; object-fit:cover; display:block; }
    .hd-hero-placeholder { width:100%; height:420px; background:linear-gradient(135deg,#1c1917,#292524); display:flex; align-items:center; justify-content:center; font-size:72px; }
    .hd-hero-overlay { position:absolute; inset:0; background:linear-gradient(to top,rgba(28,25,23,.88) 0%,rgba(28,25,23,.18) 55%); }
    .hd-hero-content { position:absolute; bottom:0; left:0; right:0; padding:32px 40px; color:#fff; }
    .hd-stars { color:var(--orange); font-size:18px; margin-bottom:8px; letter-spacing:2px; }
    .hd-hero-content h1 { font-family:var(--fd); font-size:clamp(26px,4vw,50px); font-weight:800; margin-bottom:8px; line-height:1.1; }
    .hd-hero-meta { display:flex; align-items:center; gap:18px; flex-wrap:wrap; font-size:14px; opacity:.88; }
    .hd-hero-meta span { display:flex; align-items:center; gap:5px; }

    /* ── BODY LAYOUT ── */
    .hd-body { max-width:1180px; margin:0 auto; padding:36px 24px 80px; display:grid; grid-template-columns:1fr 340px; gap:28px; align-items:start; }
    .hd-main  { min-width:0; overflow:hidden; }   /* CRITICAL: prevents grid child overflow */
    .hd-sidebar { position:sticky; top:82px; min-width:0; }

    /* ── INFO CARD ── */
    .ic { background:#fff; border-radius:var(--r-lg); padding:26px 28px; box-shadow:var(--shadow-sm); border:1px solid var(--border-soft); margin-bottom:20px; overflow:hidden; min-width:0; }
    .ic h3 { font-family:var(--fd); font-size:19px; font-weight:700; color:var(--text-dark); margin-bottom:14px; padding-bottom:10px; border-bottom:2px solid var(--orange-pale); display:flex; align-items:center; gap:8px; }

    /* ── PHOTO GALLERY (scrollable, no overflow) ── */
    .gallery-scroll-wrap {
      position:relative;
      width:100%;
      max-width:100%;
      overflow:hidden;          /* outer clips anything that escapes */
    }
    .gallery-scroll {
      display:flex;
      gap:10px;
      overflow-x:auto;
      overflow-y:visible;
      padding-bottom:12px;      /* space for scrollbar */
      width:100%;
      max-width:100%;
      scroll-behavior:smooth;
      -webkit-overflow-scrolling:touch;
      scrollbar-width:thin;
      scrollbar-color:var(--orange-light) var(--orange-pale);
      cursor:grab;
      box-sizing:border-box;
    }
    .gallery-scroll:active { cursor:grabbing; }
    .gallery-scroll::-webkit-scrollbar       { height:6px; }
    .gallery-scroll::-webkit-scrollbar-track { background:var(--orange-pale); border-radius:3px; }
    .gallery-scroll::-webkit-scrollbar-thumb { background:var(--orange-light); border-radius:3px; }
    .gallery-scroll img {
      width:200px;
      height:140px;
      object-fit:cover;
      border-radius:var(--r-md);
      flex-shrink:0;            /* images never shrink — scrollbar appears instead */
      flex-grow:0;
      cursor:pointer;
      transition:var(--tr);
      border:2px solid transparent;
      display:block;
    }
    .gallery-scroll img:hover      { transform:scale(1.03); border-color:var(--orange); }
    .gallery-scroll img.active-img { border-color:var(--orange); }

    /* Lightbox */
    .lightbox { display:none; position:fixed; inset:0; background:rgba(0,0,0,.92); z-index:9999; align-items:center; justify-content:center; padding:20px; }
    .lightbox.open { display:flex; }
    .lightbox img { max-width:90vw; max-height:88vh; object-fit:contain; border-radius:var(--r-md); }
    .lightbox-close { position:absolute; top:18px; right:22px; color:#fff; font-size:32px; cursor:pointer; background:none; border:none; line-height:1; opacity:.8; transition:opacity .2s; }
    .lightbox-close:hover { opacity:1; }
    .lightbox-nav { position:absolute; top:50%; transform:translateY(-50%); color:#fff; font-size:28px; cursor:pointer; background:rgba(255,255,255,.1); border:none; padding:12px 16px; border-radius:var(--r-sm); transition:background .2s; }
    .lightbox-nav:hover { background:rgba(255,255,255,.22); }
    .lightbox-prev { left:16px; }
    .lightbox-next { right:16px; }

    /* ── AMENITIES ── */
    .amenity-pill { display:inline-flex; align-items:center; gap:5px; padding:6px 13px; background:var(--orange-pale); color:var(--orange-dark); border-radius:var(--r-pill); font-size:12px; font-weight:600; margin:3px; }

    /* ── ROOM CARDS ── */
    .room-card { background:var(--cream); border-radius:var(--r-md); padding:20px 22px; margin-bottom:14px; border:1.5px solid var(--border-soft); transition:var(--tr); }
    .room-card:hover { border-color:var(--orange); box-shadow:var(--shadow-sm); background:#fff; }
    .room-card h4 { font-family:var(--fd); font-size:18px; color:var(--text-dark); margin-bottom:6px; }
    .room-meta { font-size:13px; color:var(--text-muted); margin-bottom:5px; display:flex; flex-wrap:wrap; gap:10px; align-items:center; }
    .room-amenity-tag { font-size:11px; color:var(--text-faint); }
    .room-avail { font-size:13px; font-weight:600; }
    .room-avail.in  { color:var(--green); }
    .room-avail.low { color:var(--orange-dark); }
    .room-avail.out { color:var(--red); }
    .room-price-big { font-family:var(--fd); font-size:24px; font-weight:800; color:var(--orange-dark); }
    .book-room-btn { display:inline-flex; align-items:center; gap:6px; padding:10px 22px; background:linear-gradient(135deg,var(--orange),var(--orange-light)); color:#fff; border-radius:var(--r-pill); font-family:var(--fb); font-weight:700; font-size:14px; margin-top:10px; transition:var(--tr); text-decoration:none; white-space:nowrap; }
    .book-room-btn:hover { transform:translateY(-2px); box-shadow:var(--shadow-md); }
    .book-room-btn.disabled { background:linear-gradient(135deg,var(--text-muted),var(--text-faint)); cursor:not-allowed; }

    /* ── SIDEBAR ── */
    .ic-sidebar { background:#fff; border-radius:var(--r-lg); padding:24px 26px; box-shadow:var(--shadow-md); border:1px solid var(--border-soft); margin-bottom:18px; border-top:4px solid var(--orange); }
    .meta-row { display:flex; align-items:flex-start; gap:10px; font-size:14px; color:var(--text-muted); margin-bottom:10px; }
    .meta-row i { color:var(--orange); width:16px; margin-top:2px; flex-shrink:0; }
    .price-from { font-family:var(--fd); font-size:26px; font-weight:800; color:var(--orange-dark); }
    .price-from small { font-family:var(--fb); font-size:13px; font-weight:400; color:var(--text-muted); }

    /* ── RESPONSIVE ── */
    @media(max-width:900px) {
      .hd-body { grid-template-columns:1fr; }
      .hd-sidebar { position:static; }
    }
    @media(max-width:600px) {
      .hd-hero-content { padding:20px; }
      .hd-hero { height:300px; }
      .hd-hero-img { height:300px; }
      .hd-hero-placeholder { height:300px; }
      .gallery-scroll img { width:170px; height:120px; }
      .hd-body { padding:20px 16px 60px; }
      .ic { padding:20px 18px; }
    }
  </style>
</head>
<body style="background:var(--cream)">
  <%- include("../partials/navbar") %>

  <!-- ── HERO ── -->
  <div class="hd-hero">
    <% if(hotel.images && hotel.images.length>0){ %>
      <img class="hd-hero-img" src="<%= hotel.images[0] %>" alt="<%= hotel.name %>">
    <% } else { %>
      <div class="hd-hero-placeholder">🏨</div>
    <% } %>
    <div class="hd-hero-overlay"></div>
    <div class="hd-hero-content">
      <div class="hd-stars"><%= "★".repeat(hotel.starRating) %><%= "☆".repeat(5-hotel.starRating) %></div>
      <h1><%= hotel.name %></h1>
      <div class="hd-hero-meta">
        <span><i class="fa-solid fa-location-dot" style="color:var(--orange-light)"></i> <%= hotel.address %></span>
        <% if(hotel.phone){ %><span><i class="fa-solid fa-phone" style="color:var(--orange-light)"></i> <%= hotel.phone %></span><% } %>
      </div>
    </div>
  </div>

  <div class="hd-body">

    <!-- ════ LEFT COLUMN ════ -->
    <div class="hd-main">

      <!-- About -->
      <div class="ic">
        <h3><i class="fa-solid fa-circle-info" style="color:var(--orange)"></i> About This Hotel</h3>
        <p style="font-size:15px;line-height:1.85;color:var(--text-muted)"><%= hotel.description %></p>
      </div>

      <!-- Photo gallery with scroll + lightbox -->
      <% if(hotel.images && hotel.images.length>0){ %>
      <div class="ic">
        <h3><i class="fa-solid fa-images" style="color:var(--orange)"></i> Photo Gallery
          <span style="font-size:13px;font-weight:400;color:var(--text-muted);margin-left:4px">(<%= hotel.images.length %> photos · scroll or click)</span>
        </h3>
        <div class="gallery-scroll-wrap">
          <div class="gallery-scroll" id="galleryScroll">
            <% hotel.images.forEach((img,i)=>{ %>
              <img src="<%= img %>"
                   alt="hotel photo <%= i+1 %>"
                   onclick="openLightbox(<%= i %>)"
                   class="<%= i===0?'active-img':'' %>">
            <% }) %>
          </div>
        </div>
      </div>
      <% } %>

      <!-- Amenities -->
      <% if(hotel.amenities && hotel.amenities.length>0){ %>
      <div class="ic">
        <h3><i class="fa-solid fa-star" style="color:var(--orange)"></i> Hotel Amenities</h3>
        <div>
          <% hotel.amenities.forEach(a=>{ %>
            <span class="amenity-pill">✓ <%= a %></span>
          <% }) %>
        </div>
      </div>
      <% } %>

      <!-- Room Types -->
      <div class="ic">
        <h3><i class="fa-solid fa-bed" style="color:var(--orange)"></i> Available Room Types</h3>
        <% if(hotel.roomTypes && hotel.roomTypes.length>0){ %>
          <% hotel.roomTypes.forEach(room=>{ %>
            <div class="room-card">
              <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:14px">

                <!-- Room info -->
                <div style="flex:1;min-width:180px">
                  <h4><%= room.type %></h4>
                  <div class="room-meta">
                    <% if(room.beds){ %><span>🛏 <%= room.beds %></span><% } %>
                    <span>👥 Max <%= room.maxGuests %> guests</span>
                    <% if(room.size){ %><span>📐 <%= room.size %></span><% } %>
                  </div>
                  <% if(room.amenities && room.amenities.length>0){ %>
                    <p class="room-amenity-tag"><%= room.amenities.join(" · ") %></p>
                  <% } %>
                  <p class="room-avail <%= room.available>3?'in':room.available>0?'low':'out' %>" style="margin-top:8px">
                    <% if(room.available>0){ %>
                      <i class="fa-solid fa-circle-check"></i> <%= room.available %> room<%= room.available>1?'s':'' %> available
                    <% } else { %>
                      <i class="fa-solid fa-circle-xmark"></i> Sold out
                    <% } %>
                  </p>
                </div>

                <!-- Price + book button -->
                <div style="text-align:right;flex-shrink:0">
                  <div class="room-price-big">₹<%= room.price.toLocaleString() %></div>
                  <div style="font-size:12px;color:var(--text-faint);margin-bottom:4px">per night</div>
                  <% if(room.available > 0){ %>
                    <% if(user){ %>
                      <a href="/hotel-owner/book/<%= hotel._id %>?room=<%= encodeURIComponent(room.type) %>" class="book-room-btn">
                        <i class="fa-solid fa-lock"></i> Book Now
                      </a>
                    <% } else { %>
                      <a href="/login" class="book-room-btn" style="background:linear-gradient(135deg,var(--text-muted),var(--text-body))">
                        Login to Book
                      </a>
                    <% } %>
                  <% } else { %>
                    <span class="book-room-btn disabled">Sold Out</span>
                  <% } %>
                </div>

              </div>
            </div>
          <% }) %>
        <% } else { %>
          <p style="color:var(--text-muted);font-size:14px">No room types configured yet.</p>
        <% } %>
      </div>

      <!-- Policies -->
      <% if(hotel.policies){ %>
      <div class="ic">
        <h3><i class="fa-solid fa-clipboard-list" style="color:var(--orange)"></i> Hotel Policies</h3>
        <p style="font-size:14px;line-height:1.85;color:var(--text-muted)"><%= hotel.policies %></p>
      </div>
      <% } %>

    </div>

    <!-- ════ RIGHT SIDEBAR ════ -->
    <div class="hd-sidebar">
      <div class="ic-sidebar">
        <div class="price-from">
          ₹<%= (hotel.price && hotel.price>0 ? hotel.price : (hotel.roomTypes&&hotel.roomTypes.length>0?hotel.roomTypes[0].price:0)).toLocaleString() %>
          <small>/ night</small>
        </div>
        <p style="font-size:12px;color:var(--text-faint);margin-bottom:18px">Starting from lowest room price</p>

        <div class="meta-row"><i class="fa-solid fa-location-dot"></i><span><%= hotel.location %></span></div>
        <% if(hotel.phone){ %><div class="meta-row"><i class="fa-solid fa-phone"></i><span><%= hotel.phone %></span></div><% } %>
        <% if(hotel.email){ %><div class="meta-row"><i class="fa-solid fa-envelope"></i><span><%= hotel.email %></span></div><% } %>
        <div class="meta-row"><i class="fa-solid fa-right-to-bracket"></i><span>Check-in: <strong><%= hotel.checkInTime %></strong></span></div>
        <div class="meta-row"><i class="fa-solid fa-right-from-bracket"></i><span>Check-out: <strong><%= hotel.checkOutTime %></strong></span></div>
        <div class="meta-row"><i class="fa-solid fa-star"></i><span><strong><%= hotel.starRating %>-Star</strong> Hotel</span></div>

        <% if(user){ %>
          <a href="/hotel-owner/book/<%= hotel._id %>" class="btn btn-orange" style="width:100%;justify-content:center;margin-top:18px;animation:none">
            <i class="fa-solid fa-calendar-check"></i> Book Now
          </a>
        <% } else { %>
          <a href="/login" class="btn btn-orange" style="width:100%;justify-content:center;margin-top:18px;animation:none">
            Login to Book
          </a>
        <% } %>
        <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(hotel.address) %>"
           target="_blank"
           class="btn btn-outline-orange"
           style="width:100%;justify-content:center;margin-top:10px">
          <i class="fa-solid fa-location-dot"></i> View on Map
        </a>
      </div>

      <!-- Quick room summary in sidebar -->
      <% if(hotel.roomTypes && hotel.roomTypes.length>0){ %>
      <div class="ic-sidebar" style="border-top-color:var(--border-soft)">
        <h3 style="font-family:var(--fd);font-size:16px;font-weight:700;color:var(--text-dark);margin-bottom:14px">Room Summary</h3>
        <% hotel.roomTypes.forEach(r=>{ %>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--border-soft);font-size:13px">
            <span style="color:var(--text-body);font-weight:500"><%= r.type %></span>
            <span style="color:var(--orange-dark);font-weight:700">₹<%= r.price.toLocaleString() %></span>
          </div>
        <% }) %>
      </div>
      <% } %>
    </div>

  </div>

  <!-- ── LIGHTBOX ── -->
  <div class="lightbox" id="lightbox" onclick="closeLightboxOnBg(event)">
    <button class="lightbox-close" onclick="closeLightbox()">×</button>
    <button class="lightbox-nav lightbox-prev" onclick="shiftLightbox(-1)">‹</button>
    <img id="lightboxImg" src="" alt="hotel photo">
    <button class="lightbox-nav lightbox-next" onclick="shiftLightbox(1)">›</button>
  </div>

  <footer class="footer"><strong>Zappit</strong><p>© 2025 Zappit. All Rights Reserved.</p></footer>

  <script>
  // ── Gallery drag-to-scroll ──
  const gs = document.getElementById("galleryScroll");
  if(gs){
    let isDown=false, startX, scrollLeft;
    gs.addEventListener("mousedown",  e=>{ isDown=true; gs.classList.add("active"); startX=e.pageX-gs.offsetLeft; scrollLeft=gs.scrollLeft; });
    gs.addEventListener("mouseleave", ()=>{ isDown=false; gs.classList.remove("active"); });
    gs.addEventListener("mouseup",    ()=>{ isDown=false; gs.classList.remove("active"); });
    gs.addEventListener("mousemove",  e=>{ if(!isDown)return; e.preventDefault(); const x=e.pageX-gs.offsetLeft; gs.scrollLeft=scrollLeft-(x-startX)*1.2; });
  }

  // ── Lightbox ──
  const images = [<% hotel.images.forEach((img,i)=>{ %>"<%= '/uploads/'+img %>"<%= i<hotel.images.length-1?',':'' %><% }) %>];
  let currentIdx = 0;

  function openLightbox(idx){
    currentIdx = idx;
    document.getElementById("lightboxImg").src = images[currentIdx];
    document.getElementById("lightbox").classList.add("open");
    document.body.style.overflow = "hidden";
  }
  function closeLightbox(){
    document.getElementById("lightbox").classList.remove("open");
    document.body.style.overflow = "";
  }
  function closeLightboxOnBg(e){
    if(e.target === document.getElementById("lightbox")) closeLightbox();
  }
  function shiftLightbox(dir){
    currentIdx = (currentIdx + dir + images.length) % images.length;
    document.getElementById("lightboxImg").src = images[currentIdx];
  }
  // Keyboard navigation
  document.addEventListener("keydown", e=>{
    if(!document.getElementById("lightbox").classList.contains("open")) return;
    if(e.key==="ArrowRight") shiftLightbox(1);
    if(e.key==="ArrowLeft")  shiftLightbox(-1);
    if(e.key==="Escape")     closeLightbox();
  });
  </script>

</body>
</html>
