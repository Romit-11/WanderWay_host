<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard – WanderWay</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="admin-bg">
  <div class="admin-overlay"></div>

  <div class="admin-container">

    <!-- Header -->
    <header class="admin-header">
      <h1>👑 Admin Dashboard</h1>
      <p style="color:rgba(255,255,255,.65);font-size:15px;margin-bottom:14px">
        Welcome, <strong style="color:var(--orange-light)"><%= admin.username %></strong>
      </p>
      <a href="/admin/logout" class="logout-btn">🚪 Logout</a>
    </header>

    <!-- Nav -->
    <div class="admin-nav">
      <a href="/admin/users">👥 Users</a>
      <a href="/admin/hotel-owners">🏨 Hotel Owners</a>
      <a href="/admin/blogs">📝 Blogs</a>
      <a href="/admin/galleries">🖼 Gallery</a>
      <a href="/admin/trending-list">🔥 Trending</a>
    </div>

    <!-- Trending Places -->
    <section class="admin-section">
      <h2>🔥 Trending Places</h2>

      <a href="/admin/add-trending" class="primary-btn">➕ Add Trending Place</a>

      <% if(trending.length === 0){ %>
        <p style="color:rgba(255,255,255,.55);font-size:14px;margin-top:16px">
          No trending places added yet.
        </p>
      <% } else { %>
        <div class="admin-grid">
          <% trending.forEach(p => { %>
            <div class="admin-card">
              <% if(p.images && p.images.length > 0){ %>
                <img src="<%- p.images[0].startsWith('http') ? p.images[0] : '/uploads/' + p.images[0] %>" alt="<%= p.name %>">
              <% } else { %>
                <div style="width:100%;height:150px;background:rgba(255,255,255,.1);border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;margin-bottom:12px;font-size:36px">🏔️</div>
              <% } %>
              <h3><%= p.name %></h3>
              <p>📍 <%= p.location %></p>
              <form action="/admin/delete-trending/<%= p._id %>" method="POST"
                    style="margin-top:auto"
                    onsubmit="return confirm('Delete <%= p.name %>?')">
                <button class="danger-btn">🗑 Delete</button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>

  </div>
</body>
</html>
