<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard – Zappit</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="admin-bg">

  <div class="admin-overlay"></div>

  <div class="admin-container">

    <!-- Header -->
    <header class="admin-header">
      <h1>👑 Admin Dashboard</h1>
      <p style="color:rgba(255,255,255,.65);font-size:15px;margin-bottom:14px">
        Welcome, <strong style="color:var(--orange-light)"><%= admin.username %></strong>
      </p>
      <a href="/admin/logout" class="logout-btn">🚪 Logout</a>
    </header>

    <!-- Nav -->
    <div class="admin-nav">
      <a href="/admin/users">👥 Users</a>
      <a href="/admin/hotel-owners">🏨 Hotel Owners</a>
      <a href="/admin/blogs">📝 Blogs</a>
      <a href="/admin/galleries">🖼 Gallery</a>
      <a href="/admin/trending-list">🔥 Trending</a>
    </div>

    <!-- Hotels -->
    <section class="admin-section">
      <h2>🏨 Manage Hotels</h2>

      <form action="/admin/hotels" method="POST" class="admin-form">
        <input type="text" name="name" placeholder="Hotel Name" required>
        <input type="text" name="location" placeholder="Location" required>
        <input type="number" name="price" placeholder="Price (₹)" required>
        <button type="submit">+ Add Hotel</button>
      </form>

      <div class="admin-grid">
        <% hotels.forEach(h => { %>
          <div class="admin-card">
            <h3><%= h.name %></h3>
            <p>📍 <%= h.location %></p>
            <p>💰 ₹<%= h.price %></p>
            <form action="/admin/hotels/delete/<%= h._id %>" method="POST" style="margin-top:auto">
              <button class="danger-btn">🗑 Delete</button>
            </form>
          </div>
        <% }) %>
      </div>
    </section>

    <!-- Trending Places -->
    <section class="admin-section">
      <h2>🔥 Trending Places</h2>

      <a href="/admin/add-trending" class="primary-btn">➕ Add Trending Place</a>

      <div class="admin-grid">
        <% trending.forEach(p => { %>
          <div class="admin-card">
            <img src="<%= p.images[0] %>" alt="<%= p.name %>">
            <h3><%= p.name %></h3>
            <p>📍 <%= p.location %></p>
            <form action="/admin/delete-trending/<%= p._id %>" method="POST" style="margin-top:auto">
              <button class="danger-btn">🗑 Delete</button>
            </form>
          </div>
        <% }) %>
      </div>
    </section>

  </div>

</body>
</html>
