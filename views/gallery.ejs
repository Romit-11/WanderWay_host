<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gallery – Zappit</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="gallery-bg">

  <%- include("partials/navbar") %>

  <!-- Page Header -->
  <div class="page-header">
    <span class="section-label" style="color:var(--orange-light)">Community Photos</span>
    <h2>Travel Memories Gallery</h2>
    <p>Stunning moments captured by our community of travellers worldwide</p>
  </div>

  <div class="container">

    <!-- Upload form -->
    <% if (user) { %>
      <div style="text-align:center;margin-bottom:32px">
        <form class="upload-form" action="/gallery/upload" method="POST" enctype="multipart/form-data">
          <input type="text" name="location" placeholder="📍 Location (e.g. Shimla, India)" required>
          <input type="file" name="images" accept="image/*" multiple required>
          <button type="submit" class="btn">📤 Upload</button>
        </form>
      </div>
    <% } else { %>
      <p class="login-prompt" style="margin-bottom:28px">
        <a href="/login">Login</a> to upload your travel memories.
      </p>
    <% } %>

    <!-- Gallery Grid -->
    <div class="gallery-grid">
      <% if (galleries && galleries.length > 0) { %>
        <% galleries.forEach(g => { %>
          <div class="gallery-item sizzle-card">
            <a href="/gallery/<%= g._id %>">
              <img src="<%- g.images[0] && g.images[0].startsWith('http') ? g.images[0] : '/uploads/' + g.images[0] %>" alt="Gallery cover">
            </a>
            <p class="location">
              <i class="fa-solid fa-location-dot"></i>
              <%= g.location %>
            </p>
            <% if (user && user.username === g.uploadedBy) { %>
              <div style="padding:0 12px 12px">
                <form action="/gallery/delete/<%= g._id %>" method="POST">
                  <button type="submit" class="btn-danger">🗑 Delete</button>
                </form>
              </div>
            <% } %>
          </div>
        <% }) %>
      <% } else { %>
        <p class="empty-msg" style="grid-column:1/-1">No images yet. Be the first to share your travel story!</p>
      <% } %>
    </div>

  </div>

  <footer class="footer">
    <strong>Zappit</strong>
    <p>© 2025 Zappit. All Rights Reserved.</p>
  </footer>

</body>
</html>
